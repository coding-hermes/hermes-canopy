# Hilo — local cache files (rebuildable). edges.jsonl is a generated edge snapshot: `hilo graph warm` rebuilds it.
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/graph.duckdb
.vfs/graph/.last_warm
.vfs/graph/.last_reconcile
.vfs/graph/.parse_cache.json
.vfs/graph/edges.jsonl

# Local development
.pytest_cache/
*.pyc
__pycache__/

# Go build artifacts
# Root-anchored on purpose: a bare `canopyd` also matches the DIRECTORY
# cmd/canopyd/, which silently makes every NEW file under it unaddable
# (`git add` exits 1 with "paths are ignored"). `/canopyd` keeps the
# `go build` artifact at the repo root ignored and nothing else.
/canopyd
bin/
*.exe
*.test
*.out

# IDE
.idea/

# Editor temp files
*.swp
*.swo
*~
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# GitReins — auto-generated verdict history
.gitreins/history/

# Environment
.env
.env.local
*.env

# E2E artifacts (screenshots + temp scripts from E2E testing ticks)
.coding-hermes/e2e-test.py
.coding-hermes/e2e-deep.py
.coding-hermes/e2e-screenshots/

# Deploy-staleness checker runtime state (crash-loop restart baseline).
# Local, machine-specific, rewritten on every run — and if it were untracked
# dirt, the checker's own --deploy gate (git status --porcelain) would refuse
# to deploy forever after the first run.
.coding-hermes/deploy-check-state.json

# GitReins judge token telemetry (per-run usage logs)
.gitreins/usage.jsonl

# DAGger MCP sandbox database (local)
dagger.db
dagger.db-shm
dagger.db-wal
