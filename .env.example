# Canopy — Environment Variables
#
# Copy this file to .env and fill in your values.
# The canopyd binary reads these from the environment.
# Canonical list: README §Environment Variables (keep in sync).

# --- Database ---
# DB_* fields are used unless CANOPY_DB_URL is set (it takes priority).
DB_HOST=localhost
DB_PORT=5432
DB_USER=canopy
DB_PASSWORD=canopy
DB_NAME=canopy
DB_SCHEMA=public
DB_SSLMODE=disable

# Override DSN; takes priority over all DB_* fields. Example:
# postgres://canopy:canopy@localhost:5432/canopy?sslmode=disable
# CANOPY_DB_URL=

# Runtime database backend. Leave blank for the default PostgreSQL path;
# accepted values are postgres and sqlite.
CANOPY_DB_DRIVER=
# SQLite path when CANOPY_DB_DRIVER=sqlite; blank uses ~/.canopy/canopy.sqlite.
CANOPY_SQLITE_PATH=

# --- HTTP Server ---
HTTP_ADDR=:8080
CORS_ORIGIN=*

# --- Auth ---
# HS256 signing secret. MUST set a real value in production
# (the default is for development only).
JWT_SECRET=dev-secret-change-me
# Optional API key; leave blank rather than copying a real credential.
API_SERVER_KEY=
# Gateway key falls back to API_SERVER_KEY when left blank.
HERMES_WEBUI_GATEWAY_API_KEY=
HERMES_WEBUI_GATEWAY_BASE_URL=http://127.0.0.1:8642
# Reference selection secret falls back to JWT_SECRET when left blank.
REFERENCE_SELECTION_SECRET=

# --- NATS ---
# Leave both blank to disable NATS wiring. Set a literal URL to enable it.
CANOPY_NATS_URL=
# Optional credentials; leave blank unless the NATS server requires them.
CANOPY_NATS_CREDS=

# --- Reverse proxy ---
# Comma-separated CIDRs. Blank trusts no forwarded proxy; entries are
# validated at startup.
CANOPY_TRUSTED_PROXIES=

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=text

# --- Observability ---
# Enable Prometheus metrics endpoint (/metrics).
METRICS_ENABLED=false

# --- Context Compiler ---
CONTEXT_MAX_ANCESTORS=50
CONTEXT_MAX_REFS=5
CONTEXT_DEFAULT_BUDGET=8000

# --- Plugins ---
# Max plugin source size in bytes (1 MB).
PLUGIN_MAX_SIZE=1048576

# --- Docker Compose ---
# Used by docker-compose.yml (not read by the binary directly).
CANOPY_DEV=false
