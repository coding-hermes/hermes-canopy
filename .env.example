# Canopy — Environment Variables
#
# Copy this file to .env and fill in your values.
# The canopyd binary reads these from the environment.
# Canonical complete reference: docs/ENV.md (keep this example in sync).

# --- Database ---
# DB_* fields are used unless CANOPY_DB_URL is set (it takes priority).
DB_HOST=localhost
DB_PORT=5432
DB_USER=canopy
DB_PASSWORD=canopy
DB_NAME=canopy
DB_SCHEMA=public
DB_SSLMODE=disable

# Override DSN; takes priority over all DB_* fields. Example:
# postgres://canopy:canopy@localhost:5432/canopy?sslmode=disable
# CANOPY_DB_URL=

# Runtime database selection. Blank/default and postgres use PostgreSQL for full
# canopyd serving. sqlite runs the SQLite schema-parity self-check only; full
# canopyd boot refuses while PostgreSQL-only repository surfaces remain. See the
# authoritative runtime contract in docs/SQLITE-RUNTIME.md.
CANOPY_DB_DRIVER=
# SQLite path used by the schema-parity self-check when
# CANOPY_DB_DRIVER=sqlite; blank uses ~/.canopy/canopy.sqlite.
CANOPY_SQLITE_PATH=
# Card store directory: one SQLite database per card type, used verbatim
# (docs/ENV.md). Blank uses ~/.hermes/canopy/cards.
CANOPY_CARD_DATA_DIR=

# --- HTTP Server ---
HTTP_ADDR=:8080
CORS_ORIGIN=*

# --- Auth ---
# HS256 signing secret. MUST set a real value in production
# (the default is for development only).
JWT_SECRET=dev-secret-change-me
# Optional API key; leave blank rather than copying a real credential.
API_SERVER_KEY=
# Gateway key falls back to API_SERVER_KEY when left blank.
HERMES_WEBUI_GATEWAY_API_KEY=
HERMES_WEBUI_GATEWAY_BASE_URL=http://127.0.0.1:8642
# Reference selection secret falls back to JWT_SECRET when left blank.
REFERENCE_SELECTION_SECRET=

# --- NATS ---
# Leave both blank to disable NATS wiring. Set a literal URL to enable it.
CANOPY_NATS_URL=
# Optional credentials; leave blank unless the NATS server requires them.
CANOPY_NATS_CREDS=

# --- Deployment ---
# CANOPY_ENV gates well-known dev secrets (JWT, profile-router key) and behavior.
# Set to "production" to disable defaults. Options: development, staging, production.
CANOPY_ENV=development

# AES-256 encryption key for the profile router (exactly 32 bytes).
# Must be set to a random 32-byte value in production deployments.
CANOPY_PROFILE_ROUTER_SECRET=

# --- File storage / gateway state ---
# Root directory for uploaded file bytes (SPEC-PL-02 §7.6, docs/ENV.md); objects
# land under it at files/<aa>/<sha256>. Blank uses ~/.canopy/files.
CANOPY_FILE_ROOT=
# Gateway run-registry JSONL file. Names the FILE, not a directory, and is used
# verbatim (docs/ENV.md). Blank derives a per-instance path from HTTP_ADDR:
# ~/.hermes/canopy/gateway/runs-<port>.jsonl.
CANOPY_GATEWAY_STATE_FILE=

# --- Reverse proxy ---
# Comma-separated CIDRs. Blank trusts no forwarded proxy; entries are
# validated at startup.
CANOPY_TRUSTED_PROXIES=

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=text

# --- Observability ---
# Enable Prometheus metrics endpoint (/metrics).
METRICS_ENABLED=false

# --- Context Compiler ---
CONTEXT_MAX_ANCESTORS=50
CONTEXT_MAX_REFS=5
CONTEXT_DEFAULT_BUDGET=8000
# Percentage of the selected model's known context window used as the default
# budget; accepted range 0-100, where 0 disables the window-derived path.
CONTEXT_BUDGET_PERCENT=60
# Max topic-search results the retrieved tier may fold into a payload; accepted
# range 0-50, where 0 disables the tier.
CONTEXT_RETRIEVAL_MAX=0
# Locally declared context windows for models the gateway reports no window
# for, as comma-separated model-name / window pairs (docs/ENV.md). Blank means
# no overrides; a malformed pair is a startup error.
CONTEXT_MODEL_WINDOWS=

# --- Plugins ---
# Max plugin source size in bytes (1 MB).
PLUGIN_MAX_SIZE=1048576

# --- Integrations ---
# Production Pion WebRTC transport: registered only when the value is exactly
# "1"; blank leaves WebRTC off (docs/ENV.md).
CANOPY_WEBRTC_ENABLED=
# Signed updates: manifest URL override. Blank uses the updater's built-in
# per-channel default; the -update-manifest-url flag wins over this value.
CANOPY_UPDATE_MANIFEST_URL=
# Signed updates: path to a hex-encoded Ed25519 public key file (64 hex chars)
# overriding the key embedded in the binary; the -update-public-key-file flag
# wins over this value.
CANOPY_UPDATE_PUBLIC_KEY_FILE=

# --- CLI ---
# API base URL the canopyd CLI talks to (docs/ENV.md); the documented default is
# http://localhost:8091. The CLI refuses to guess whenever HTTP_ADDR or DB_* are
# present, so set this explicitly before using the tree/topic commands.
# CANOPY_SERVER_URL=
# Bearer token sent with each CLI request; leave blank rather than copying a
# real credential.
CANOPY_TOKEN=
# Owner UUID used by canopyd session import/update commands. Blank keeps the dev
# user 00000000-0000-0000-0000-000000000001 (docs/ENV.md).
CANOPY_OWNER_ID=

# --- Test infrastructure ---
# Consumed by the Go test harness (internal/testutil) and CI, never by canopyd
# itself (docs/ENV.md). Left commented so copying this file cannot silence or
# break the integration suite.
# Skip integration tests unconditionally, before any DB gate.
# CANOPY_SKIP_INTEGRATION=
# PostgreSQL admin URL for test setup/teardown, e.g. a local server.
# CANOPY_ADMIN_DB_URL=
# PostgreSQL server URL the tests target; falls back to the admin URL above.
# CANOPY_TEST_DB_URL=
# "1" opts in to running tests against the default production-shared PostgreSQL.
# CANOPY_TEST_ALLOW_SHARED_DB=
# "1" (CI mode) makes integration tests FAIL instead of skip when PostgreSQL is
# unreachable.
# CANOPY_REQUIRE_DB=
# PG requirement marker for the integration benchmark harness only; no code
# reads this name.
# CANOPY_DATABASE_URL=

# --- Docker Compose ---
# Used by docker-compose.yml (not read by the binary directly).
CANOPY_DEV=false
