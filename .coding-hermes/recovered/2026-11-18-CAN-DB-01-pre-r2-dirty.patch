+// attachMemberRoster fills the EC-23 roster fields of a tree detail from one
+// page of the tree's memberships. It is the read the GET /trees/{tree_id}
+// detail has always advertised with include_members and never performed
+// (CAN-DB-01); the rows come from TreeMemberRepo.ListByTree — the identical
+// call the GET /trees/{tree_id}/members route pages — so the two responses
+// cannot drift.
+//
+// Members always ends up non-nil here: a tree with no memberships answers
+// `"members": []`, never a missing key and never null. Truncation follows
+// EC-23 — the page is MemberRosterCap rows and total_members is the real
+// count for the whole (visibility-filtered) roster, so
+// members_truncated == total > len(members).
+func (s *TreeServiceImpl) attachMemberRoster(ctx context.Context, detail *TreeDetail, tree db.Tree, callerID uuid.UUID) error {
+	if s.memberRepo == nil {
+		// Never answer an empty roster for a service that simply has no
+		// membership repository wired: that is the CAN-DB-01 defect in a
+		// new disguise (an empty array reads as "the tree has no
+		// members").
+		return ErrMemberRosterUnavailable
+	}
+
+	includeHidden, err := s.rosterIncludesHidden(ctx, tree, callerID)
+	if err != nil {
+		return err
+	}
+	rows, total, err := s.memberRepo.ListByTree(ctx, tree.ID, includeHidden, MemberRosterCap, 0)
+	if err != nil {
+		return fmt.Errorf("%w: members: %v", ErrDatabaseUnavailable, err)
+	}
+
+	members := make([]MemberSummary, 0, len(rows))
+	for _, row := range rows {
+		members = append(members, memberSummaryOf(row))
+	}
+	truncated := total > len(members)
+
+	detail.Members = &members
+	detail.MembersTruncated = &truncated
+	detail.TotalMembers = &total
+	return nil
+}
+
+// rosterIncludesHidden applies SPEC-API-06 §9.5 to the detail roster: owners
+// and admins see every membership, members and viewers only is_visible rows.
+//
+// The owner check reads the tree row rather than tree_members because
+// CreateTree's owner-membership insert is best-effort — an owner without a
+// membership row still owns the tree. An unknown caller (uuid.Nil) gets the
+// restricted view.
+func (s *TreeServiceImpl) rosterIncludesHidden(ctx context.Context, tree db.Tree, callerID uuid.UUID) (bool, error) {
+	if callerID == uuid.Nil {
+		return false, nil
+	}
+	if tree.OwnerID != uuid.Nil && tree.OwnerID == callerID {
+		return true, nil
+	}
+	role, isMember, err := s.memberRepo.IsMember(ctx, tree.ID, callerID)
+	if err != nil {
+		return false, fmt.Errorf("%w: members: membership check: %v", ErrDatabaseUnavailable, err)
+	}
+	if !isMember {
+		return false, nil
+	}
+	return role == db.TreeRoleOwner || role == db.TreeRoleAdmin, nil
+}
+
+// memberSummaryOf maps one joined membership row onto the detail entry
+// SPEC-API-02 §5.3 documents. The fields mirror what the members route
+// returns for the same row (SPEC-API-06 §9.3), so a client can compare the
+// two responses entry-for-entry.
+func memberSummaryOf(row db.TreeMemberSummary) MemberSummary {
+	participantType := row.ParticipantType
+	if participantType == "" {
+		// Derive it when a repository leaves the join's CASE column empty,
+		// the same rule the members handler applies.
+		participantType = "profile"
+		if row.UserID != nil {
+			participantType = "human"
+		}
+	}
+	return MemberSummary{
+		ID:              row.ID,
+		UserID:          row.UserID,
+		ProfileID:       row.ProfileID,
+		ParticipantType: participantType,
+		DisplayName:     row.DisplayName,
+		Role:            MemberRole(row.Role),
+		JoinedAt:        row.JoinedAt,
+	}
+}
